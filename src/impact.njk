---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ lang.dir }}impact.html"
layout: base.njk
key: impact
file: impact.html
depth: 0
---
{%- set m = t.impact %}
{%- set loc = lng.locale %}
{#- Every number on this page comes from impactFigures.json (the Annual Report 2021-22),
    prepared by impact.js. The wording for each number is in the "impact" part of the
    language files. Charts are plain HTML, so they read correctly without the script. -#}
<main id="main" class="infographic">
{#- Flat figures used as counting marks in the charts below. Each is drawn once here
    and reused by name, so a chart of 176 people stays a few bytes per person. -#}
<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="pic-person" viewBox="0 0 24 24"><circle cx="12" cy="4.2" r="2.7"/><path d="M8.2 8h7.6a2 2 0 0 1 2 2v6.2a1.1 1.1 0 0 1-2.2 0V11h-.6v11a1.3 1.3 0 0 1-2.6 0v-6h-.8v6a1.3 1.3 0 0 1-2.6 0V11h-.6v5.2a1.1 1.1 0 0 1-2.2 0V10a2 2 0 0 1 2-2z"/></symbol>
  <symbol id="pic-woman" viewBox="0 0 24 24"><circle cx="12" cy="4.2" r="2.7"/><path d="M9.3 8h5.4a2 2 0 0 1 1.9 1.4l1.9 6a1.05 1.05 0 0 1-2 .7L15.2 12l2.3 6.5h-2.3V22a1.2 1.2 0 0 1-2.4 0v-3.5h-1.6V22a1.2 1.2 0 0 1-2.4 0v-3.5H6.5L8.8 12l-1.3 4.1a1.05 1.05 0 0 1-2-.7l1.9-6A2 2 0 0 1 9.3 8z"/></symbol>
  <symbol id="pic-child" viewBox="3 4.6 18 18"><circle cx="12" cy="8.2" r="3.1"/><path d="M8.9 12.4h6.2a1.9 1.9 0 0 1 1.9 1.9v3.2a1 1 0 0 1-2 0v-2.3h-.4V21a1.15 1.15 0 0 1-2.3 0v-3.1h-.6V21a1.15 1.15 0 0 1-2.3 0v-5.8H9v2.3a1 1 0 0 1-2 0v-3.2a1.9 1.9 0 0 1 1.9-1.9z"/></symbol>
  <symbol id="pic-cross" viewBox="0 0 24 24"><path d="M9.6 4.5h4.8a1 1 0 0 1 1 1v4.1h4.1a1 1 0 0 1 1 1v4.8a1 1 0 0 1-1 1h-4.1v4.1a1 1 0 0 1-1 1H9.6a1 1 0 0 1-1-1v-4.1H4.5a1 1 0 0 1-1-1v-4.8a1 1 0 0 1 1-1h4.1V5.5a1 1 0 0 1 1-1z"/></symbol>
  <symbol id="pic-drop" viewBox="0 0 24 24"><path d="M12 3.2c3 4 5.8 7.3 5.8 11a5.8 5.8 0 0 1-11.6 0c0-3.7 2.8-7 5.8-11z"/></symbol>
</svg>
{%- set familyPics = { children: "child", care: "cross", mothers: "woman", community: "drop" } %}
{%- set studentPics = { women: "woman", men: "person" } %}
{%- set reachIcons = { static: "clinic", satellite: "pin", wards: "map", staff: "family" } %}
<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="{{ up }}index.html">{{ t.nav.home }}</a><span aria-hidden="true">/</span>{{ t.nav.impact }}</div>
    <h1>{{ m.h1 }}</h1>
    <p>{{ m.lead }}</p>
    <div class="actions hero-actions">
      <a class="btn btn-white" href="{{ root }}{{ impact.reports[0].file }}" target="_blank" rel="noopener">{{ m.report_cta }} {% icon "arrow", 2.4 %}</a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="glance-h">
  <div class="container">
    <div class="glance" data-reveal>
      <div class="glance-main">
        <span class="eyebrow">{{ m.head_eyebrow }} · {{ m.period }}</span>
        <h2 id="glance-h" class="mega"><b data-count="{{ impact.contacts }}">{{ impact.contacts | num(loc) }}</b>{{ m.contacts_label }}</h2>
        <p class="glance-every">{{ m.every | replace("{s}", impact.everySeconds | num(loc)) }}</p>
        <p class="glance-then">{{ m.then | replace("{times}", impact.timesSince1994 | num(loc, 1)) | replace("{then}", impact.contacts_1994 | num(loc)) }}</p>
        <div class="circle-pair" aria-hidden="true">
          <div><span class="bubble then" style="--r: {{ impact.growth.thenRadius }}"></span><b>{{ impact.contacts_1994 | num(loc) }}</b><small>{{ "1994" | digits(lng.code) }}</small></div>
          <div><span class="bubble" style="--r: {{ impact.growth.nowRadius }}"></span><b>{{ impact.contacts | num(loc) }}</b><small>{{ "2021-22" | digits(lng.code) }}</small></div>
        </div>
        {%- set shareText = (m.share_text | replace("{n}", impact.contacts | num(loc)) | replace("{s}", impact.everySeconds | num(loc))) + " " + site.url + lng.dir + "impact.html" %}
        <div class="share-row">
          <a class="btn btn-wa" href="https://wa.me/?text={{ shareText | urlencode }}" target="_blank" rel="noopener">{% icon "chat" %} {{ m.share_wa }}</a>
          <button class="btn btn-outline js-only" type="button" data-share data-done="{{ t.rebuild.share_copied }}">{{ t.rebuild.share_btn }}</button>
        </div>
      </div>
      <dl class="glance-side">
        {%- for f in impact.reach %}
        <div><dd><span class="card-ico" aria-hidden="true">{% icon reachIcons[f.id], 1.8 %}</span><span data-count="{{ f.value }}">{{ f.value | num(loc) }}</span></dd><dt>{{ m.reach[f.id] }}</dt></div>
        {%- endfor %}
      </dl>
    </div>
  </div>
  <div class="container history" data-reveal>
    <span class="eyebrow">{{ m.history_eyebrow }}</span>
    <h2>{{ m.history_title }}</h2>
    <ol class="steps milestones">
      {%- for stone in impact.milestones %}
      <li>
        <span class="card-ico" aria-hidden="true">{% icon stone.icon, 1.8 %}</span>
        <b>{{ stone.year | digits(lng.code) }}</b>
        <span class="step-what">{{ m.milestones[stone.id] }}</span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section tint" aria-labelledby="mix-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">{{ m.mix_eyebrow }}</span>
        <h2 id="mix-h">{{ m.mix_title }}</h2>
        <p>{{ m.mix_intro }}</p>
      </div>
    </div>
    <div class="mix" data-reveal>
      <div class="pictogram hundred" role="img" aria-label="{{ m.mix_aria }}">
        {%- for family in impact.mix %}{% for row in family.rows %}{% for n in range(row.squares) %}<svg class="pic tone-{{ family.id }} shade-{{ row.shade }}"><use href="#pic-{{ familyPics[family.id] }}"/></svg>{% endfor %}{% endfor %}{% endfor %}
      </div>
      <div class="mix-legend">
        {%- for family in impact.mix %}
        <div class="mix-family">
          <h3><svg class="pic tone-{{ family.id }}" aria-hidden="true"><use href="#pic-{{ familyPics[family.id] }}"/></svg>{{ m.mix_families[family.id] }}<b>{{ m.in_hundred | replace("{n}", family.squares | num(loc)) }}</b></h3>
          <ul>
            {%- for row in family.rows %}
            <li><svg class="pic tone-{{ family.id }} shade-{{ row.shade }}" aria-hidden="true"><use href="#pic-{{ familyPics[family.id] }}"/></svg><span>{{ m.mix_rows[row.id] }}</span><b>{{ row.value | num(loc) }}</b></li>
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="year-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">{{ m.year_eyebrow }}</span>
        <h2 id="year-h">{{ m.year_title }}</h2>
        <p>{{ m.journey_intro }}</p>
      </div>
    </div>
    <div class="journeys">
      {%- for journey in impact.journeys %}
      <div class="journey" data-reveal>
        <h3><svg class="pic tone-{{ journey.tone }}" aria-hidden="true"><use href="#pic-{{ journey.pic }}"/></svg>{{ m.journeys[journey.id] }}</h3>
        <ol class="steps">
          {%- for step in journey.steps %}
          <li>
            <span class="card-ico" aria-hidden="true">{% icon step.icon, 1.8 %}</span>
            <span class="step-when">{{ m.journey_steps[step.id].when }}</span>
            <b data-count="{{ step.value }}">{{ step.value | num(loc) }}</b>
            <span class="step-what">{{ m.journey_steps[step.id].what }}</span>
          </li>
          {%- endfor %}
        </ol>
      </div>
      {%- endfor %}
    </div>
    <div class="cards four">
      {%- for group in impact.groups %}
      <article class="card stat-card" data-reveal style="--d:{{ loop.index0 }}">
        {%- if group.photo | hasPhoto %}
        <div class="photo">{% photo root, group.photo, "" %}</div>
        {%- endif %}
        <div class="body">
          <h3>{{ m.groups[group.id] }}</h3>
          <dl class="stats">
            {%- for stat in group.stats %}
            <div><dd data-count="{{ stat.value }}">{{ stat.value | num(loc) }}</dd><dt>{{ m.stats[stat.id] }}</dt></div>
            {%- endfor %}
          </dl>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="vaccines-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">{{ m.vaccines_eyebrow }}</span>
        <h2 id="vaccines-h">{{ m.vaccines_title | replace("{total}", impact.vaccineTotal | num(loc)) | replace("{kinds}", impact.vaccineKinds | num(loc)) }}</h2>
        <p>{{ m.vaccines_intro }}</p>
      </div>
    </div>
    <div class="vaccine-groups">
      {%- for group in impact.vaccines %}
      <figure class="chart on-white" data-reveal style="--d:{{ loop.index0 }}">
        <figcaption><i class="cap-ico" aria-hidden="true">{% icon "syringe", 2 %}</i>{{ m.vaccine_groups[group.id] }}<span>{{ group.value | num(loc) }}</span></figcaption>
        <ol class="bubbles{% if group.id == 'other' %} quiet{% endif %}">
          {%- for row in group.rows %}
          <li><span class="bubble" style="--r: {{ row.radius }}" aria-hidden="true"></span><b>{{ row.value | num(loc) }}</b><span>{{ m.vaccine_names[row.id] }}</span></li>
          {%- endfor %}
        </ol>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="trend-h">
  <div class="container split even">
    <div data-reveal>
      <span class="eyebrow">{{ m.trend_eyebrow }}</span>
      <h2 id="trend-h">{{ m.trend_title }}</h2>
      <p class="note">{{ m.trend_intro }}</p>
      <div class="filters chart-tabs js-only" role="group" aria-label="{{ m.trend_aria }}">
        {%- for s in impact.series %}
        <button class="filter" type="button" data-chart-tab="{{ s.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ m.series[s.id] }}</button>
        {%- endfor %}
      </div>
    </div>
    <div class="charts" data-reveal style="--d:1">
      {%- for s in impact.series %}
      <figure class="chart" data-chart="{{ s.id }}">
        <figcaption>{{ m.series[s.id] }}</figcaption>
        <svg class="line-chart" viewBox="0 0 {{ s.chart.width }} {{ s.chart.height }}" aria-hidden="true" focusable="false">
          <line class="floor" x1="0" y1="{{ s.chart.floor }}" x2="{{ s.chart.width }}" y2="{{ s.chart.floor }}"/>
          <path class="area" d="{{ s.chart.area }}"/>
          <path class="gap" d="{{ s.chart.gap }}"/>
          <path class="line" d="{{ s.chart.line }}" pathLength="1"/>
          {%- for point in s.chart.points %}
          <g class="point{% if loop.last %} latest{% endif %}{% if loop.first %} first{% endif %}">
            <circle cx="{{ point.x }}" cy="{{ point.y }}" r="{{ 7 if loop.last else 5 }}"/>
            <text class="val" x="{{ point.x }}" y="{{ point.y - 14 }}">{{ point.value | num(loc) }}</text>
            <text class="yr" x="{{ point.x }}" y="{{ s.chart.floor + 24 }}">{{ point.year | digits(lng.code) }}</text>
          </g>
          {%- endfor %}
        </svg>
        <ol class="bars">
          {%- for bar in s.bars %}
          <li{% if loop.last %} class="latest"{% endif %}>
            <span class="bar-year">{{ bar.year | digits(lng.code) }}</span>
            <span class="bar-track"><span class="bar" style="width: {{ bar.width }}%"></span></span>
            <b>{{ bar.value | num(loc) }}</b>
          </li>
          {%- endfor %}
        </ol>
      </figure>
      {%- endfor %}
    </div>
  </div>
  <div class="container compare" data-reveal>
    <div class="section-head">
      <div>
        <span class="eyebrow">{{ m.compare_eyebrow }}</span>
        <h2 id="compare-h">{{ m.compare_title }}</h2>
        <p>{{ m.compare_intro }}</p>
      </div>
      <p class="chart-key"><span><i class="key key-then" aria-hidden="true"></i>{{ impact.compare.from | digits(lng.code) }}</span><span><i class="key key-ink" aria-hidden="true"></i>{{ impact.compare.to | digits(lng.code) }}</span></p>
    </div>
    <ol class="compare-list">
      {%- for row in impact.compare.rows %}
      {%- set rose = row.change >= 0 %}
      <li>
        <span class="compare-name">{{ m.compare_rows[row.id] }}</span>
        <b class="change {{ 'up' if rose else 'down' }}">{% set changeIcon = "up" if rose else "down" %}{% icon changeIcon, 2.6 %}{{ m.percent | replace("{n}", ("+" if rose else "-") + (row.change | abs | num(loc))) }}</b>
        <span class="slope-row">
          <span class="slope-then">{{ row.before | num(loc) }}</span>
          <svg class="slope" viewBox="0 0 120 70" aria-hidden="true" focusable="false">
            <line class="floor" x1="0" y1="{{ row.slope.floor }}" x2="120" y2="{{ row.slope.floor }}"/>
            <line class="rise" x1="{{ row.slope.x1 }}" y1="{{ row.slope.y1 }}" x2="{{ row.slope.x2 }}" y2="{{ row.slope.y2 }}" pathLength="1"/>
            <circle class="then" cx="{{ row.slope.x1 }}" cy="{{ row.slope.y1 }}" r="6"/>
            <circle class="now" cx="{{ row.slope.x2 }}" cy="{{ row.slope.y2 }}" r="7"/>
          </svg>
          <b class="slope-now">{{ row.after | num(loc) }}</b>
        </span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section tint" aria-labelledby="targets-h">
  <div class="container split even">
    <div data-reveal>
      <span class="eyebrow">{{ m.targets_eyebrow }}</span>
      <h2 id="targets-h">{{ m.targets_title | replace("{met}", impact.targetsMet | num(loc)) | replace("{all}", impact.targets | length | num(loc)) }}</h2>
      <p class="note">{{ m.targets_intro }}</p>
      <p class="chart-key"><span><i class="key key-local" aria-hidden="true"></i>{{ m.targets_done }}</span><span><i class="key key-mark" aria-hidden="true"></i>{{ m.targets_goal }}</span></p>
    </div>
    <ol class="targets" data-reveal style="--d:1">
      {%- for row in impact.targets %}
      <li>
        <div class="target-head"><span><i class="mark {{ 'met' if row.percent >= 100 else 'short' }}" aria-hidden="true">{% set markIcon = "check" if row.percent >= 100 else "alert" %}{% icon markIcon, 3 %}</i>{{ m.target_names[row.id] }}</span><b class="{{ 'met' if row.percent >= 100 else 'short' }}">{{ m.percent | replace("{n}", row.percent | num(loc)) }}</b></div>
        <div class="target-track" aria-hidden="true"><span class="bar" style="width: {{ row.width }}%"></span><i style="left: {{ row.mark }}%"></i></div>
        <div class="target-foot">{{ m.target_line | replace("{done}", row.achieved | num(loc)) | replace("{goal}", row.target | num(loc)) }}{% if row.previousPercent %}<span class="target-prev">{{ m.target_previous | replace("{n}", row.previousPercent | num(loc)) }}</span>{% endif %}</div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="fund-h">
  <div class="container split even">
    <div data-reveal>
      <span class="eyebrow">{{ m.fund_eyebrow }}</span>
      <h2 id="fund-h">{{ m.fund_title }}</h2>
      <div class="prose">
        {%- for p in m.fund_body %}
        <p>{{ p }}</p>
        {%- endfor %}
      </div>
    </div>
    <div class="fund" data-reveal style="--d:1">
      {%- for row in impact.funding %}
      <div class="fund-row">
        <div class="fund-year">{{ row.year | digits(lng.code) }}</div>
        <div class="fund-track" aria-hidden="true">
          {%- if row.foreign %}<span class="fund-foreign" style="width: {{ row.foreignShare }}%"></span>{% endif -%}
          <span class="fund-local" style="width: {{ row.localShare }}%"></span>
        </div>
        <dl>
          <div><dt><i class="key key-foreign" aria-hidden="true"></i>{{ m.fund_foreign }}</dt><dd>{% if row.foreign %}{{ m.fund_unit | replace("{n}", row.foreign | num(loc, 2)) }}{% else %}{{ m.fund_none }}{% endif %}</dd></div>
          <div><dt><i class="key key-local" aria-hidden="true"></i>{{ m.fund_local }}</dt><dd>{{ m.fund_unit | replace("{n}", row.local | num(loc, 2)) }}</dd></div>
        </dl>
      </div>
      {%- endfor %}
      <figure class="chart finance">
        <figcaption>{{ m.finance_title }}</figcaption>
        <p class="chart-key"><span><i class="key key-local" aria-hidden="true"></i>{{ m.finance_income }}</span><span><i class="key key-ink" aria-hidden="true"></i>{{ m.finance_spending }}</span></p>
        <ol class="pairs">
          {%- for row in impact.finance %}
          <li>
            <span class="bar-year">{{ row.year | digits(lng.code) }}</span>
            <span class="pair">
              <span class="pair-row"><span class="bar" style="--w: {{ row.incomeWidth }}"></span><b>{{ row.income | num(loc, 2) }}</b></span>
              <span class="pair-row spend"><span class="bar" style="--w: {{ row.spendingWidth }}"></span><b>{{ row.spending | num(loc, 2) }}</b></span>
            </span>
          </li>
          {%- endfor %}
        </ol>
      </figure>
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="people-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">{{ m.people_eyebrow }}</span>
        <h2 id="people-h">{{ m.people_title }}</h2>
      </div>
    </div>
    <div class="people-grid">
      <div class="panel" data-reveal>
        <h3>{{ m.wards_title }}</h3>
        <p class="note">{{ m.wards_intro }}</p>
        <div class="ward-group"><b>{{ m.wards_north }}</b><div class="wards">{% for w in impact.wards.north %}<span><b>{{ w | num(loc) }}</b></span>{% endfor %}</div></div>
        <div class="ward-group south"><b>{{ m.wards_south }}</b><div class="wards">{% for w in impact.wards.south %}<span><b>{{ w | num(loc) }}</b></span>{% endfor %}</div></div>
      </div>
      <div class="panel" data-reveal style="--d:1">
        <h3>{{ m.staff_title | replace("{n}", impact.staffTotal | num(loc)) }}</h3>
        <div class="pictogram staff" aria-hidden="true">{% for row in impact.staff %}{% set unit = loop.index0 %}{% for n in range(row.value) %}<svg class="pic tone-u{{ unit }}"><use href="#pic-person"/></svg>{% endfor %}{% endfor %}</div>
        <ul class="staff-list">
          {%- for row in impact.staff %}
          <li><svg class="pic tone-u{{ loop.index0 }}" aria-hidden="true"><use href="#pic-person"/></svg><span>{{ m.staff_units[row.id] }}</span><b>{{ row.value | num(loc) }}</b></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="partners-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">{{ m.partners_eyebrow }}</span>
        <h2 id="partners-h">{{ m.partners_title }}</h2>
        <p>{{ m.partners_intro }}</p>
      </div>
    </div>
    <div class="partners">
      <div class="partner-group" data-reveal>
        <h3>{{ m.gov_title }}</h3>
        <ul class="partner-list">
          {%- for p in m.gov %}
          <li><b>{{ p.name }}</b><span>{{ p.role }}</span></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="partner-group" data-reveal style="--d:1">
        <h3>{{ m.projects_title }}</h3>
        <ul class="partner-list two">
          {%- for p in m.projects %}
          <li><b>{{ p.name }}</b><span>{{ p.role }}</span></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
    <p class="note thanks" data-reveal>{{ m.thanks }}</p>
  </div>
</section>

<section class="section tint feature{% if not ("community" | hasPhoto) %} no-media{% endif %}" aria-labelledby="campaigns-h">
  <div class="container">
    {%- if "community" | hasPhoto %}
    <div class="feature-media" data-reveal><div class="photo">{% photo root, "community", m.community_alt %}</div></div>
    {%- endif %}
    <div class="body" data-reveal style="--d:1">
      <span class="eyebrow">{{ m.campaigns_eyebrow }}</span>
      <h2 id="campaigns-h">{{ m.campaigns_title }}</h2>
      {%- for p in m.campaigns_body %}
      <p>{{ p }}</p>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="institute-h">
  <div class="container split even">
    <div data-reveal>
      <span class="eyebrow">{{ m.institute_eyebrow }}</span>
      <h2 id="institute-h">{{ m.institute_title }}</h2>
      <div class="pictogram students" role="img" aria-label="{{ m.students_aria }}">
        {%- for group in impact.students %}{% for n in range(group.value) %}<svg class="pic tone-{{ group.id }}"><use href="#pic-{{ studentPics[group.id] }}"/></svg>{% endfor %}{% endfor %}
      </div>
      <p class="chart-key">
        {%- for group in impact.students %}
        <span><svg class="pic key-pic tone-{{ group.id }}" aria-hidden="true"><use href="#pic-{{ studentPics[group.id] }}"/></svg>{{ m.students[group.id] | replace("{n}", group.value | num(loc)) }}</span>
        {%- endfor %}
      </p>
    </div>
    <div class="prose" data-reveal style="--d:1">
      {%- for p in m.institute_body %}
      <p{% if loop.first %} class="lede"{% endif %}>{{ p }}</p>
      {%- endfor %}
      <p><a class="more" href="{{ up }}news.html">{{ m.institute_link }}</a></p>
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="source-h">
  <div class="container narrow">
    <div class="source-note" data-reveal>
      <h2 id="source-h">{{ m.source_title }}</h2>
      <p>{{ m.source_body }}</p>
    </div>
    <div class="reports" id="reports" data-reveal>
      <h2>{{ m.reports_title }}</h2>
      <ul>
        {%- for report in impact.reports %}
        <li>
          <span class="card-ico" aria-hidden="true">{% icon "file", 1.8 %}</span>
          <span class="report-name"><strong>{{ m.report_name | replace("{year}", report.year | digits(lng.code)) }}</strong><small>{{ m.report_meta | replace("{pages}", report.pages | num(loc)) | replace("{size}", report.sizeMb | num(loc, 1)) }}</small>{% if report.note %}<small>{{ m.report_notes[report.note] }}</small>{% endif %}</span>
          <a class="btn btn-outline" href="{{ root }}{{ report.file }}" target="_blank" rel="noopener">{{ m.report_open }} {% icon "download", 2.2 %}</a>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

{%- set bandTitle = t.home.band_title %}{% set bandBody = t.home.band_body %}
{% include "band.njk" %}
</main>
