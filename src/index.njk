---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ lang.dir }}index.html"
layout: base.njk
key: home
file: index.html
depth: 0
---
{%- set h = t.home %}
{#- Service notices: any news item marked "notice": true. It hides itself after "notice_until" (YYYY-MM-DD). -#}
{%- for item in news %}{% if item.notice %}
<div class="notice" role="region" aria-label="{{ h.notice_aria }}"{% if item.notice_until %} data-until="{{ item.notice_until }}"{% endif %}>
  <div class="container">
    <span class="tag">{{ h.notice_tag }}</span>
    <a class="notice-link" {% if item.url %}href="{{ item.url }}" target="_blank" rel="noopener"{% else %}href="{{ up }}news/{{ item.id }}.html"{% endif %}><span>{{ item[lng.code].title }}</span><b>{{ h.read_more }} {% icon "arrow", 2.4 %}</b></a>
  </div>
</div>
{%- endif %}{% endfor %}

<main id="main">
{% include "pictograms.njk" %}
{#- Hero carousel. The slides are listed in the wording files under home.slides; a slide
    marked "appeal" is left out while the rebuild appeal is switched off. -#}
<section class="hero" data-carousel aria-roledescription="carousel" aria-label="{{ h.carousel.label }}">
  <div class="slides">
    {%- set shown = 0 %}
    {%- for s in h.slides %}{% if not s.appeal or appeal.published %}
    {%- set shown = shown + 1 %}
    <div class="slide{% if shown == 1 %} is-active{% endif %}{% if not (s.photo | hasPhoto) %} no-photo{% endif %}" role="group" aria-roledescription="slide">
      {%- if s.photo | hasPhoto %}
      <div class="photo slide-photo">{% photo root, s.photo, s.alt, "eager" if loop.first else "lazy" %}</div>
      {%- endif %}
      <div class="slide-panel">
        {% if loop.first %}<h1>{{ s.title }}</h1>{% else %}<h2>{{ s.title }}</h2>{% endif %}
        <p>{{ s.body }}</p>
        <a class="btn btn-white" href="{{ up }}{{ s.href }}">{{ s.cta }}</a>
      </div>
    </div>
    {%- endif %}{% endfor %}
  </div>
  <div class="carousel-controls js-only">
    <button class="carousel-btn" type="button" data-carousel-prev aria-label="{{ h.carousel.prev }}">{% icon "prev", 2.6 %}</button>
    <button class="carousel-btn" type="button" data-carousel-next aria-label="{{ h.carousel.next }}">{% icon "next", 2.6 %}</button>
    <button class="carousel-btn" type="button" data-carousel-toggle aria-pressed="true" aria-label="{{ h.carousel.pause }}" data-label-pause="{{ h.carousel.pause }}" data-label-play="{{ h.carousel.play }}"><span class="i-pause">{% icon "pause", 2.8 %}</span><span class="i-play">{% icon "play", 2.4 %}</span></button>
    <div class="dots">
      {%- for s in h.slides %}{% if not s.appeal or appeal.published %}
      <button class="dot" type="button" data-slide-to aria-label="{{ s.title }}"></button>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<div class="quick">
  <div class="container">
    <div class="quick-grid">
      <div class="q" data-status>
        <span class="q-ico">{% icon "clock" %}</span>
        <span class="q-body"><span class="q-k">{{ h.quick.hours_k }}</span><strong data-status-title>{{ h.quick.hours_a }}</strong><small data-status-detail>{{ h.quick.hours_b }}</small></span>
      </div>
      <a class="q" href="tel:{{ site.phone_tel }}">
        <span class="q-ico">{% icon "phone" %}</span>
        <span class="q-body"><span class="q-k">{{ h.quick.call_k }}</span><strong>{{ site.phone_display }}</strong><small>{{ h.quick.call_b }}</small></span>
      </a>
      <a class="q" href="https://wa.me/{{ site.clinic.whatsapp }}" target="_blank" rel="noopener">
        <span class="q-ico">{% icon "chat" %}</span>
        <span class="q-body"><span class="q-k">{{ h.quick.wa_k }}</span><strong>{{ h.quick.wa_a }}</strong><small>{{ h.quick.wa_b }}</small></span>
      </a>
      <a class="q" href="{{ up }}visit.html#locations">
        <span class="q-ico">{% icon "pin" %}</span>
        <span class="q-body"><span class="q-k">{{ h.quick.find_k }}</span><strong>{{ h.quick.find_a }}</strong><small>{{ h.quick.find_b }}</small></span>
      </a>
    </div>
  </div>
</div>

<section class="finder" aria-labelledby="finder-h">
  <div class="container" data-reveal>
    <div class="finder-head">
      <h2 id="finder-h">{{ h.finder_title }}</h2>
      <p>{{ h.finder_sub }}</p>
    </div>
    <div class="finder-chips">
      {%- for opt in t.visit.options %}
      <a class="finder-chip" href="{{ up }}visit.html?service={{ opt.key }}#register"><strong>{{ opt.label }}</strong><small>{{ opt.sub }}</small>{% icon "arrow", 2.4 %}</a>
      {%- endfor %}
    </div>
    <div class="tools-teaser">
      {%- for kind in ["vaccine", "pregnancy"] %}
      <a class="teaser" href="{{ up }}tools.html#{{ kind }}"><span class="card-ico" aria-hidden="true">{% set toolIcon = "shield" if kind == "vaccine" else "heart" %}{% icon toolIcon, 1.8 %}</span><span><strong>{{ t.tools[kind].title }}</strong><small>{{ t.tools[kind].teaser }}</small></span>{% icon "arrow", 2.4 %}</a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section tint" id="news" aria-labelledby="news-h">
  <div class="container">
    <div class="section-head centre" data-reveal>
      <h2 id="news-h">{{ h.news_title }}</h2>
    </div>
    <div class="news-home">
      {%- for item in homeNews %}{% if loop.first %}
      {% include "news-card.njk" %}
      {%- endif %}{% endfor %}
      <div class="news-stack">
        {%- for item in homeNews %}{% if not loop.first %}
        {% include "news-card.njk" %}
        {%- endif %}{% endfor %}
      </div>
    </div>
    <div class="section-foot"><a class="btn btn-outline" href="{{ up }}news.html">{{ h.news_all }}</a></div>
  </div>
</section>

<section class="section" aria-labelledby="svc-h">
  <div class="container">
    <div class="section-head centre" data-reveal>
      <h2 id="svc-h">{{ h.svc_title }}</h2>
    </div>
    <div class="cards">
      {%- for card in h.cards %}
      <article class="card" data-reveal style="--d:{{ loop.index0 }}">
        {%- if card.id | hasPhoto %}
        <div class="photo">{% photo root, card.id, card.alt %}</div>
        {%- endif %}
        <div class="body">
          {%- if not (card.id | hasPhoto) %}
          <span class="card-ico">{% icon serviceMeta[card.id].icon, 1.8 %}</span>
          {%- endif %}
          <div class="card-type"><b>{{ card.label }}</b></div>
          <h3><a href="{{ up }}services.html#{{ card.id }}">{{ card.title }}</a></h3>
          <p>{{ card.body }}</p>
          <span class="more" aria-hidden="true">{{ h.learn_more }}</span>
        </div>
      </article>
      {%- endfor %}
    </div>
    <div class="section-foot"><a class="btn btn-outline" href="{{ up }}services.html">{{ h.svc_all }}</a></div>
  </div>
</section>

<section class="section figures-wrap" aria-labelledby="fig-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="fig-h">{{ h.fig_title }}</h2>
    </div>
    {#- Guess first, then see: the answer is on the page from the start (so it works
        without the script) and the script only keeps it out of sight until a guess. -#}
    <div class="guess" data-guess data-reveal>
      <p class="guess-q">{{ h.guess_q }}</p>
      <div class="guess-options js-only" role="group" aria-label="{{ h.guess_q }}">
        {%- for option in h.guess_options %}
        <button class="btn btn-outline" type="button" data-guess-option{% if loop.last %} data-right{% endif %}>{{ option }}</button>
        {%- endfor %}
      </div>
      <div class="guess-answer" aria-live="polite">
        <span class="guess-verdict" data-right-text="{{ h.guess_right }}" data-wrong-text="{{ h.guess_wrong }}"></span>
        <strong data-count="{{ impact.contacts }}">{{ impact.contacts | num(lng.locale) }}</strong>
        <span>{{ h.guess_answer | replace("{s}", impact.everySeconds | num(lng.locale)) }}</span>
      </div>
    </div>
    {%- set familyPics = { children: "child", care: "cross", mothers: "woman", community: "drop" } %}
    {%- set total = impact.series[0] %}
    <div class="home-graphics">
      <div class="home-graphic" data-reveal>
        <h3>{{ t.impact.mix_title }}</h3>
        <div class="pictogram hundred" role="img" aria-label="{{ t.impact.mix_aria }}">
          {%- for family in impact.mix %}{% for row in family.rows %}{% for n in range(row.squares) %}<svg class="pic tone-{{ family.id }}"><use href="#pic-{{ familyPics[family.id] }}"/></svg>{% endfor %}{% endfor %}{% endfor %}
        </div>
        <p class="graphic-key">
          {%- for family in impact.mix %}
          <span><svg class="pic tone-{{ family.id }}" aria-hidden="true"><use href="#pic-{{ familyPics[family.id] }}"/></svg>{{ family.squares | num(lng.locale) }} {{ t.impact.mix_families[family.id] }}</span>
          {%- endfor %}
        </p>
      </div>
      <div class="home-graphic" data-reveal style="--d:1">
        <h3>{{ h.g_trend_title | replace("{times}", impact.timesSince1994 | num(lng.locale, 1)) }}</h3>
        <svg class="line-chart always" viewBox="0 0 {{ total.chart.width }} {{ total.chart.height }}" aria-hidden="true" focusable="false">
          <line class="floor" x1="0" y1="{{ total.chart.floor }}" x2="{{ total.chart.width }}" y2="{{ total.chart.floor }}"/>
          <path class="area" d="{{ total.chart.area }}"/>
          <path class="gap" d="{{ total.chart.gap }}"/>
          <path class="line" d="{{ total.chart.line }}" pathLength="1"/>
          {%- for point in total.chart.points %}
          <g class="point{% if loop.last %} latest{% endif %}{% if loop.first %} first{% endif %}"><circle cx="{{ point.x }}" cy="{{ point.y }}" r="{{ 11 if loop.last else 7 }}"/></g>
          {%- endfor %}
        </svg>
        <p>{{ h.g_trend_caption | replace("{then}", impact.contacts_1994 | num(lng.locale)) | replace("{now}", impact.contacts | num(lng.locale)) }}</p>
      </div>
      <div class="home-graphic" data-reveal style="--d:2">
        <h3>{{ h.g_net_title | replace("{static}", impact.reachBy.static | num(lng.locale)) | replace("{satellite}", impact.reachBy.satellite | num(lng.locale)) }}</h3>
        <div class="pictogram net" aria-hidden="true">
          {%- for n in range(impact.reachBy.static) %}<span class="net-clinic">{% icon "clinic", 1.8 %}</span>{% endfor %}<i class="net-break"></i>{% for n in range(impact.reachBy.satellite) %}<span class="net-pin">{% icon "pin", 2 %}</span>{% endfor %}
        </div>
        <p>{{ h.g_net_caption | replace("{wards}", impact.reachBy.wards | num(lng.locale)) }}</p>
      </div>
    </div>
    <div class="figures-foot" data-reveal>
      <span>{{ h.fig_note }}</span>
      <a class="more" href="{{ up }}impact.html">{{ h.fig_link }}</a>
    </div>
  </div>
</section>

<section class="section tint feature{% if not ("about" | hasPhoto) %} no-media{% endif %}" aria-labelledby="story-h">
  <div class="container">
    {%- if "about" | hasPhoto %}
    <div class="feature-media" data-reveal><div class="photo">{% photo root, "about", h.story_alt %}</div></div>
    {%- endif %}
    <div class="body" data-reveal style="--d:1">
      <span class="eyebrow">{{ h.story_eyebrow }}</span>
      <h2 id="story-h">{{ h.story_title }}</h2>
      {%- for p in h.story %}
      <p>{{ p }}</p>
      {%- endfor %}
      {%- set yearIcons = ["clinic", "family", "growth"] %}
      <div class="years" aria-hidden="true">
        {%- for y in h.years %}
        <div><span class="card-ico">{% icon yearIcons[loop.index0], 1.8 %}</span><b>{{ y.n }}</b><span>{{ y.label }}</span></div>{% if not loop.last %}<i></i>{% endif %}
        {%- endfor %}
      </div>
      <a class="more" href="{{ up }}about.html">{{ h.story_link }}</a>
    </div>
  </div>
</section>

<section class="section commit" aria-labelledby="commit-h">
  <div class="container">
    <div class="intro" data-reveal>
      <h2 id="commit-h">{{ h.commit_title }}</h2>
      <p>{{ h.commit_intro }}</p>
    </div>
    {%- set commitIcons = ["heart", "shield", "family"] %}
    {%- for c in h.commit %}
    <div class="item" data-reveal style="--d:{{ loop.index }}">
      <span class="card-ico" aria-hidden="true">{% icon commitIcons[loop.index0], 1.8 %}</span>
      <h3>{{ c.title }}</h3>
      <p>{{ c.body }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

{#- Closing band, the same shape as the hero: a photograph with a cyan panel. -#}
<section class="cta-photo{% if not ("support" | hasPhoto) %} no-photo{% endif %}" aria-labelledby="cta-h">
  {%- if "support" | hasPhoto %}
  <div class="photo">{% photo root, "support", t.visit.support_alt %}</div>
  {%- endif %}
  <div class="cta-panel">
    <h2 id="cta-h">{{ t.about.band_title }}</h2>
    <p>{{ t.about.band_body }}</p>
    <div class="actions">
      <a class="btn btn-accent" href="{{ up }}{{ 'rebuild.html' if appeal.published else 'visit.html#support' }}">{{ t.rebuild.nav if appeal.published else t.about.band_cta }}</a>
      <a class="btn btn-white" href="{{ up }}visit.html#register">{{ t.nav.cta }}</a>
    </div>
  </div>
</section>
</main>
