<!DOCTYPE html>
<html lang="{{ lng.code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " · " + t.meta.org) if title else t.pages[key].title %}
{%- set pageDesc = desc or t.pages[key].desc %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ lng.dir }}{{ file }}">
<meta property="og:site_name" content="{{ t.meta.org }}">
<meta property="og:image" content="{{ site.url }}assets/img/share-{{ lng.code }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:locale" content="{{ lng.og }}">
<meta name="theme-color" content="#06306f">
<link rel="canonical" href="{{ site.url }}{{ lng.dir }}{{ file }}">
{%- for l in langs %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}{{ l.dir }}{{ file }}">
{%- endfor %}
<link rel="icon" href="{{ root }}assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ root }}assets/img/icon-180.png">
<link rel="manifest" href="{{ root }}site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500..800{% if lng.code == 'bn' %}&amp;family=Hind+Siliguri:wght@400;600{% else %}&amp;family=Source+Sans+3:wght@400..700{% endif %}&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}assets/css/site.css">
<script type="application/ld+json">{{ clinicSchema[lng.code] | dump | safe }}</script>
<script>document.documentElement.classList.add("js")</script>
</head>
<body>
<a class="skip" href="#main">{{ t.meta.skip }}</a>
<div class="utility">
  <div class="container">
    <div class="u-left">
      <span class="status" data-status hidden><i aria-hidden="true"></i><span data-status-title></span></span>
      <span class="u-hours">{{ t.meta.hours_short }}</span>
    </div>
    <div class="u-right">
      <a class="u-extra" href="tel:{{ site.phone_tel }}">{{ site.phone_display }}</a>
      <a class="u-extra" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a class="lang-switch" href="{{ root }}{{ otherLang.dir }}{{ file }}" lang="{{ otherLang.code }}" hreflang="{{ otherLang.code }}" aria-label="{{ t.nav.switch_aria }}" data-lang="{{ otherLang.code }}">{{ t.nav.switch_to }}</a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container">
    <a class="logo" href="{{ up }}index.html" aria-label="{{ t.meta.home_aria }}">
      <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#0a5cb8"/><circle cx="20" cy="14.5" r="4.6" fill="#fff"/><path d="M11.5 37c0-8.6 3.6-15 8.5-15 2.4 0 4.4 1.3 5.8 3.4" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/><circle cx="30.5" cy="24.5" r="3.4" fill="#fff"/><path d="M23.5 37c0-4.8 3.1-8.2 7-8.2s7 3.4 7 8.2" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/></svg>
      <span class="logo-text"><strong>{{ t.meta.logo_name }}</strong><span>{{ t.meta.logo_sub }}</span></span>
    </a>
    <button class="menu-btn" type="button" aria-controls="nav" aria-expanded="false" aria-label="{{ t.nav.open_menu }}"><span></span><span></span></button>
    <nav class="nav" id="nav" aria-label="{{ t.nav.aria }}">
      {%- for item in ["home", "services", "about", "news", "visit"] %}
      <a href="{{ up }}{{ t.pages[item].file }}"{% if key == item %} aria-current="page"{% endif %}>{{ t.nav[item] }}</a>
      {%- endfor %}
      <a class="btn btn-primary nav-cta" href="{{ up }}visit.html#register">{{ t.nav.cta }}</a>
    </nav>
    <button class="search-btn" type="button" aria-label="{{ t.nav.search }}" aria-haspopup="dialog" data-search-open>{% icon "search", 2.2 %}</button>
    <a class="btn btn-primary header-cta" href="{{ up }}visit.html#register">{{ t.nav.cta }}</a>
  </div>
</header>

{{ content | safe }}

<footer class="site-footer">
  <div class="container top">
    <div>
      <a class="logo" href="{{ up }}index.html" aria-label="{{ t.meta.home_aria }}">
        <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#0a5cb8"/><circle cx="20" cy="14.5" r="4.6" fill="#fff"/><path d="M11.5 37c0-8.6 3.6-15 8.5-15 2.4 0 4.4 1.3 5.8 3.4" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/><circle cx="30.5" cy="24.5" r="3.4" fill="#fff"/><path d="M23.5 37c0-4.8 3.1-8.2 7-8.2s7 3.4 7 8.2" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/></svg>
        <span class="logo-text"><strong>{{ t.meta.logo_name }}</strong><span>{{ t.meta.logo_sub }}</span></span>
      </a>
      <p>{{ t.footer.about }}</p>
      <div class="social">
        <a href="{{ site.facebook_url }}" target="_blank" rel="noopener" aria-label="{{ t.footer.facebook_aria }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z"/></svg></a>
        <a href="mailto:{{ site.email }}" aria-label="{{ t.footer.email_aria }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2L4 7.4V17h16V7.4l-8 4.8ZM5.2 7 12 11l6.8-4H5.2Z"/></svg></a>
        <a href="tel:{{ site.phone_tel }}" aria-label="{{ t.footer.call_aria }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg></a>
      </div>
    </div>
    <div>
      <h2>{{ t.footer.care }}</h2>
      <ul>
        {%- for link in t.footer.care_links %}
        <li><a href="{{ up }}{{ link.href }}">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h2>{{ t.footer.radda }}</h2>
      <ul>
        {%- for link in t.footer.radda_links %}
        <li><a href="{{ up }}{{ link.href }}">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h2>{{ t.footer.contact }}</h2>
      <ul>
        <li><a href="tel:{{ site.phone_tel }}">{{ site.phone_display }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li>{{ t.footer.address }}</li>
        <li>{{ t.footer.hours }}</li>
        <li>{{ t.footer.closed }}</li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <span>© <span id="year">2026</span> {{ t.footer.rights }}</span>
    <span>{{ t.footer.partner }}</span>
  </div>
</footer>

<nav class="mbar" aria-label="{{ t.mbar.aria }}">
  <a href="tel:{{ site.phone_tel }}">{% icon "phone" %}{{ t.mbar.call }}</a>
  <a href="https://wa.me/{{ site.clinic.whatsapp }}" target="_blank" rel="noopener">{% icon "chat" %}{{ t.mbar.whatsapp }}</a>
  <a href="{{ up }}visit.html#register">{{ t.mbar.visit }}</a>
</nav>

<div class="search" id="search" role="dialog" aria-modal="true" aria-label="{{ t.search.title }}" hidden>
  <div class="search-box">
    <div class="search-row">
      {% icon "search", 2.2 %}
      <input type="search" id="search-input" placeholder="{{ t.search.placeholder }}" aria-label="{{ t.search.title }}" autocomplete="off" spellcheck="false">
      <button class="search-close" type="button" aria-label="{{ t.search.close }}" data-search-close>{% icon "close", 2.2 %}</button>
    </div>
    <p class="search-hint" id="search-hint">{{ t.search.hint }}</p>
    <ul class="search-results" id="search-results" aria-live="polite"></ul>
  </div>
</div>

{%- set config = { lang: lng.code, locale: lng.locale, up: up, phone: site.phone_display, clinic: site.clinic, t: t.js } %}
<script>window.RADDA = {{ config | dump | safe }};</script>
<script src="{{ root }}assets/js/site.js" onerror="document.documentElement.classList.remove('js')"></script>
</body>
</html>
