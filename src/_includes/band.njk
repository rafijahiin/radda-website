{#- Call-to-action band. Set bandTitle, bandBody and (optionally) bandCta + bandHref before including. -#}
<div class="band-wrap{% if bandFlush %} flush{% endif %}">
  <section class="band" aria-labelledby="band-h" data-reveal>
    <div>
      <h2 id="band-h">{{ bandTitle }}</h2>
      <p>{{ bandBody }}</p>
    </div>
    <div class="actions">
      <a class="btn btn-sun" href="{{ bandHref or (up + 'visit.html#register') }}">{{ bandCta or t.nav.cta }} {% icon "arrow", 2.4 %}</a>
      {%- if not bandCta %}
      <a class="btn btn-line-white" href="tel:{{ site.phone_tel }}">{{ t.meta.call_on | replace("{phone}", site.phone_display) }}</a>
      {%- endif %}
    </div>
  </section>
</div>
