---
permalink: 404.html
eleventyExcludeFromCollections: true
---
{#- Shown for any address that does not exist. It can appear at any path, so every
    link is resolved from the site's own address (the <base> tag below), and since
    the reader's language is unknown, it speaks both. -#}
{%- set en = i18n.en %}{% set bn = i18n.bn %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ en.notfound.title }} · {{ en.meta.org }}</title>
<base href="{{ site.url }}">
<meta name="theme-color" content="#06306f">
<link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500..800&amp;family=Source+Sans+3:wght@400..700&amp;family=Hind+Siliguri:wght@400;600&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/site.css">
</head>
<body class="notfound">
<main class="page-hero" id="main">
  <div class="container">
    <a class="logo" href="index.html" aria-label="{{ en.meta.home_aria }}">
      <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#fff" fill-opacity=".16"/><circle cx="20" cy="14.5" r="4.6" fill="#fff"/><path d="M11.5 37c0-8.6 3.6-15 8.5-15 2.4 0 4.4 1.3 5.8 3.4" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/><circle cx="30.5" cy="24.5" r="3.4" fill="#fff"/><path d="M23.5 37c0-4.8 3.1-8.2 7-8.2s7 3.4 7 8.2" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/></svg>
      <span class="logo-text"><strong>{{ en.meta.logo_name }}</strong><span>{{ en.meta.logo_sub }}</span></span>
    </a>
    <h1>{{ en.notfound.title }}</h1>
    <p>{{ en.notfound.body }}</p>
    <div class="actions">
      <a class="btn btn-sun" href="index.html">{{ en.notfound.home }}</a>
      <a class="btn btn-line-white" href="visit.html">{{ en.nav.visit }}</a>
    </div>
    <div class="bn-text" lang="bn">
      <h2>{{ bn.notfound.title }}</h2>
      <p>{{ bn.notfound.body }}</p>
      <div class="actions">
        <a class="btn btn-sun" href="bn/index.html">{{ bn.notfound.home }}</a>
        <a class="btn btn-line-white" href="bn/visit.html">{{ bn.nav.visit }}</a>
      </div>
    </div>
    <p class="notfound-call"><a href="tel:{{ site.phone_tel }}">{{ site.phone_display }}</a></p>
  </div>
</main>
</body>
</html>
