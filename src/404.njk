---
permalink: 404.html
eleventyExcludeFromCollections: true
---
{#- Shown for any address that does not exist. It can appear at any path, so every
    link is resolved from the site's own address (the <base> tag below), and since
    the reader's language is unknown, it speaks both. -#}
{%- set en = i18n.en %}{% set bn = i18n.bn %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ en.notfound.title }} · {{ en.meta.org }}</title>
<base href="{{ site.url }}">
<meta name="theme-color" content="#06306f">
<link rel="icon" href="assets/img/icon-32.png" type="image/png" sizes="32x32">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&amp;family=Noto+Sans+Bengali:wght@400;700&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/site.css?v={{ assetVersion.css }}">
</head>
<body class="notfound">
<main class="page-hero" id="main">
  <div class="container">
    <a class="logo" href="index.html" aria-label="{{ en.meta.home_aria }}">
      <img src="assets/img/logo-radda-white.png" alt="" width="46" height="46">
      <span class="logo-text"><strong>{{ en.meta.logo_name }}</strong><span>{{ en.meta.logo_sub }}</span></span>
    </a>
    <h1>{{ en.notfound.title }}</h1>
    <p>{{ en.notfound.body }}</p>
    <div class="actions">
      <a class="btn btn-white" href="index.html">{{ en.notfound.home }}</a>
      <a class="btn btn-outline" href="visit.html">{{ en.nav.visit }}</a>
    </div>
    <div class="bn-text" lang="bn">
      <h2>{{ bn.notfound.title }}</h2>
      <p>{{ bn.notfound.body }}</p>
      <div class="actions">
        <a class="btn btn-white" href="bn/index.html">{{ bn.notfound.home }}</a>
        <a class="btn btn-outline" href="bn/visit.html">{{ bn.nav.visit }}</a>
      </div>
    </div>
    <p class="notfound-call"><a href="tel:{{ site.phone_tel }}">{{ site.phone_display }}</a></p>
  </div>
</main>
</body>
</html>
